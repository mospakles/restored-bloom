# ─────────────────────────────────────────────────────────────────────────────
# Restored Bloom: environment variables
# Copy to `.env` for local development. In production, set these in your
# hosting provider's environment settings. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (e.g. Neon, Supabase, Railway, RDS, or local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Secret used to sign sessions and form tokens. At least 32 random characters.
# Generate one with:  openssl rand -base64 36
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# The public URL of the site, without a trailing slash.
BETTER_AUTH_URL="https://www.example.org"
NEXT_PUBLIC_SITE_URL="https://www.example.org"

# ── Optional: separate secret for hashing IP addresses (rate limiting) ──────
# Defaults to BETTER_AUTH_SECRET if unset.
IP_HASH_SECRET=""

# ── Optional: transactional email (SMTP) ─────────────────────────────────────
# Without these, the site works but sends NO email: no staff alerts, no
# acknowledgements, no password-reset emails, and the newsletter stays hidden.
# Any SMTP provider works (e.g. Brevo, Postmark, Resend SMTP, Zoho, Google Workspace).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"          # "true" for port 465
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Restored Bloom <no-reply@example.org>"

# Comma-separated staff addresses that receive "new submission" alerts.
# Alerts contain only a reference and a dashboard link, never submission contents.
ADMIN_NOTIFICATION_EMAILS=""

# ── Optional: privacy-friendly analytics (Plausible) ─────────────────────────
# When set, visitors are asked for consent before analytics load. Never runs on /admin.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# NEXT_PUBLIC_PLAUSIBLE_SRC="https://plausible.io/js/script.js"

# ── Testing only ─────────────────────────────────────────────────────────────
# A DISPOSABLE database for integration tests. It is wiped on every test run.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restored_bloom_test"

# ── Online donations ─────────────────────────────────────────────────────────
# Not implemented. No payment provider has been approved yet. See README
# ("Pending: online donations"). Do not add payment keys here until then.
